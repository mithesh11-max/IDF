# Copy this file to .env.local and fill in the two values below to switch on
# real accounts (Google / email+password+verification) and live-syncing admin
# edits. Leave .env.local absent or empty and the site runs exactly as before
# — this is entirely optional. See HANDOVER.md -> "Accounts and live sync".

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
